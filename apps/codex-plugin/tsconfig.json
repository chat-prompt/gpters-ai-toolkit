{
  "extends": "@gpters/tsconfig/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "moduleResolution": "bundler",
    "types": ["node"]
  },
  "include": ["src", "bin"],
  "exclude": ["node_modules", "dist", "tests"]
}
