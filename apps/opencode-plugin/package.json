{
  "name": "@gpters/opencode",
  "version": "0.1.3",
  "description": "GPTers OpenCode Plugin",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/bin"
  ],
  "scripts": {
    "build": "PLUGIN_VERSION=$(node -p \"require('./package.json').version\") && bun build src/index.ts --outdir dist --target bun --format esm --define \"process.env.PLUGIN_VERSION='$PLUGIN_VERSION'\" && tsc --emitDeclarationOnly && cp -r bin dist/",
    "dev": "bun build src/index.ts --outdir dist --target bun --format esm --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "opencode",
    "plugin",
    "gpters"
  ],
  "author": "GPTers",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gpters/gpters-ai-toolkit.git",
    "directory": "apps/opencode-plugin"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.1.36",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@gpters/tsconfig": "workspace:*",
    "@opencode-ai/sdk": "^1.1.36",
    "bun-types": "latest",
    "typescript": "^5"
  }
}
