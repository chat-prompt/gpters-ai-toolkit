{
  "name": "@gpters/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run with-env -- next dev",
    "with-env": "dotenv -e ../../.env",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:api": "node scripts/assert-isolated-api-tests.mjs && vitest run tests/api",
    "clean": "rm -rf .next .turbo node_modules"
  },
  "dependencies": {
    "@gpters/db": "workspace:*",
    "@gpters/lib": "workspace:*",
    "@vercel/blob": "^2.3.3",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "jszip": "^3.10.1",
    "next": "16.2.11",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.8.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@gpters/tsconfig": "workspace:*",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.16",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.0",
    "happy-dom": "^20.0.11",
    "jsdom": "^27.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.16"
  }
}
