{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "incremental": true
  },
  "references": [
    { "path": "./packages/tsconfig" },
    { "path": "./packages/db" },
    { "path": "./packages/lib" },
    { "path": "./apps/web" },
    { "path": "./apps/opencode-plugin" }
  ],
  "files": [],
  "exclude": ["node_modules", "**/node_modules", "**/dist", "**/.next", "**/.turbo"]
}
