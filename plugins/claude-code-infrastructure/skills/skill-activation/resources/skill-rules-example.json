{
  "backend-dev-guidelines": {
    "keywords": [
      "backend",
      "api",
      "route",
      "controller",
      "database",
      "prisma",
      "drizzle",
      "sql",
      "migration",
      "endpoint"
    ],
    "file_patterns": [
      "app/api/**/*.ts",
      "lib/db/**/*.ts",
      "controllers/**/*.ts",
      "models/**/*.ts",
      "services/**/*.ts"
    ],
    "intent_patterns": [
      "(create|add|implement|fix|update).*?(route|endpoint|api|controller)",
      "(database|db|query|migration|schema)"
    ],
    "content_triggers": [
      "router\\.",
      "prisma\\.",
      "drizzle\\.",
      "db\\.",
      "export.*Controller",
      "NextResponse"
    ],
    "priority": 1
  },
  "frontend-dev-guidelines": {
    "keywords": [
      "component",
      "ui",
      "react",
      "frontend",
      "css",
      "tailwind",
      "responsive",
      "accessibility",
      "a11y",
      "button",
      "form",
      "modal"
    ],
    "file_patterns": [
      "components/**/*.tsx",
      "app/**/page.tsx",
      "app/**/layout.tsx",
      "styles/**/*.css"
    ],
    "intent_patterns": [
      "(create|build|add|implement).*?(component|page|ui|button|form|modal)",
      "(style|design|layout|responsive|mobile)"
    ],
    "content_triggers": [
      "useState",
      "useEffect",
      "useContext",
      "className=",
      "'use client'"
    ],
    "priority": 1
  },
  "testing-guidelines": {
    "keywords": [
      "test",
      "testing",
      "jest",
      "vitest",
      "playwright",
      "e2e",
      "unit",
      "integration",
      "coverage",
      "spec"
    ],
    "file_patterns": [
      "tests/**/*.ts",
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.spec.ts",
      "e2e/**/*.ts"
    ],
    "intent_patterns": [
      "(write|add|create|fix|update).*?(test|spec)",
      "(testing|coverage|assertion)"
    ],
    "content_triggers": [
      "describe\\(",
      "it\\(",
      "test\\(",
      "expect\\(",
      "vitest",
      "playwright"
    ],
    "priority": 2
  },
  "security-guidelines": {
    "keywords": [
      "security",
      "auth",
      "authentication",
      "authorization",
      "jwt",
      "session",
      "password",
      "encryption",
      "vulnerability"
    ],
    "file_patterns": [
      "lib/auth/**/*.ts",
      "middleware.ts",
      "app/api/auth/**/*.ts"
    ],
    "intent_patterns": [
      "(implement|add|fix).*?(auth|security|login|session)",
      "(protect|secure|validate|sanitize)"
    ],
    "content_triggers": [
      "getServerSession",
      "signIn",
      "signOut",
      "bcrypt",
      "jwt"
    ],
    "priority": 0
  },
  "dev-docs-pattern": {
    "keywords": [
      "dev docs",
      "context",
      "plan",
      "session",
      "continue",
      "resume"
    ],
    "file_patterns": [
      "dev/active/**/*.md"
    ],
    "intent_patterns": [
      "(create|update|read).*?(dev docs|plan|context|tasks)",
      "(continue|resume|pick up).*?work"
    ],
    "content_triggers": [],
    "priority": 3
  }
}
