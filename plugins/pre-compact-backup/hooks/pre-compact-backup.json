{
  "PreCompact": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "mkdir -p ~/claude-backups && cp \"$transcript_path\" ~/claude-backups/transcript-$(echo $session_id | cut -c1-8)-$(date +%Y%m%d-%H%M%S).jsonl",
          "timeout": 30000,
          "blocking": true
        }
      ]
    }
  ]
}