# ===========================================
# AI Toolkit - Production Environment Variables
# ===========================================
# Minimum required variables for production deployment.
# Copy to your hosting platform's environment settings.

# --- Required ---
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXT_PUBLIC_BASE_URL="https://your-domain.com"

# --- Recommended ---
NEXT_PUBLIC_SITE_NAME="AI Toolkit"
CONTACT_EMAIL="admin@your-domain.com"
CRON_SECRET="generate-with-openssl-rand-base64-32"

# --- Optional ---
# INTERNAL_ORGANIZATION_DOMAIN=""
# GH_TOKEN=""
# GH_OWNER=""
# GH_REPO=""
# GH_BRANCH="main"
# GEMINI_API_KEY=""
# GPTERS_ANALYTICS_URL=""
# SLACK_WEBHOOK_URL=""
