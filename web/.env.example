# Neon Database URL
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Admin password for catalog management
ADMIN_PASSWORD="your-secure-admin-password"

# GitHub API Configuration for Marketplace Sync
# Get your personal access token from: https://github.com/settings/tokens
# Required scopes: repo (Full control of private repositories)
# Note: Using GH_ prefix because Vercel doesn't allow GITHUB_ prefix
GH_TOKEN="ghp_your_personal_access_token"
GH_OWNER="chat-prompt"
GH_REPO="gpters-ai-toolkit"
GH_BRANCH="main"
GH_MARKETPLACE_PATH="marketplace"
