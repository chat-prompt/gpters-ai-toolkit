# Load this before apps/web/.env.local. dotenv-cli keeps the first value, so the
# isolated database wins while unrelated local credentials remain available.
DATABASE_URL="postgresql://gpters:gpters_local_only@127.0.0.1:55432/gpters_ax_local"
DATABASE_DRIVER="postgres-js"
DEV_BYPASS_AUTH="true"
INTERNAL_ORGANIZATION_DOMAIN="gpters.org"
NEXT_PUBLIC_BASE_URL="http://localhost:3002"
