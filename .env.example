# ===========================================
# GPTers AI Toolkit - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values

# -------------------------------------------
# Database (Required)
# -------------------------------------------
# Neon PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# -------------------------------------------
# Authentication (Required for Production)
# -------------------------------------------
# Google OAuth credentials
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# NextAuth.js configuration
# Generate secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret"
# NEXTAUTH_URL is auto-detected on Vercel, set manually for other platforms
# NEXTAUTH_URL="https://your-domain.com"

# Base URL for the application (used in OAuth, MCP, sitemap, etc.)
NEXT_PUBLIC_BASE_URL="https://ai-toolkit.gpters.org"

# -------------------------------------------
# GitHub API (Optional - for Marketplace Sync)
# -------------------------------------------
# Personal access token with 'repo' scope
# Create at: https://github.com/settings/tokens
# Note: Using GH_ prefix because Vercel doesn't allow GITHUB_ prefix
GH_TOKEN="ghp_your_personal_access_token"
GH_OWNER="chat-prompt"
GH_REPO="gpters-ai-toolkit"
GH_BRANCH="main"

# -------------------------------------------
# Gemini API (Optional - for Semantic Search)
# -------------------------------------------
# API key for generating embeddings (gemini-embedding-001)
# Create at: https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"

# -------------------------------------------
# Analytics (Optional - for gpters-analytics Worker)
# -------------------------------------------
# URL of the gpters-analytics Worker for event forwarding
# Set in Vercel environment variables for production
GPTERS_ANALYTICS_URL="https://gpters-analytics.kangjun-f0f.workers.dev"

# -------------------------------------------
# Development Options
# -------------------------------------------
# Bypass authentication in development (set to "true" to enable)
DEV_BYPASS_AUTH="false"

# Logging level (debug, info, warn, error)
LOG_LEVEL="debug"

# -------------------------------------------
# Slack Notifications (Optional)
# -------------------------------------------
# Incoming Webhook URL for deploy notifications
# Create at: https://api.slack.com/messaging/webhooks
# SLACK_WEBHOOK_URL="https://hooks.slack.com/services/..."

# -------------------------------------------
# Cron Jobs (Required for Production)
# -------------------------------------------
# Secret token for authenticating cron job requests
# Generate: openssl rand -base64 32
# CRON_SECRET="your-cron-secret"

# -------------------------------------------
# Testing (Optional - for isolated test environment)
# -------------------------------------------
# Separate test database to prevent test data from appearing in production
# Create a separate Neon database branch for testing
# TEST_DATABASE_URL="postgresql://user:password@test-host.neon.tech/testdb?sslmode=require"
