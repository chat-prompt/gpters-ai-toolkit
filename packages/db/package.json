{
  "name": "@gpters/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "default": "./src/schema.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push --force",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "npx tsx src/migrate.ts",
    "db:preflight:agent-telemetry": "tsx scripts/preflight-agent-telemetry.ts",
    "db:preflight:ax": "tsx scripts/preflight-ax-migrations.ts",
    "db:migrate:ax-child": "tsx scripts/apply-ax-child-migrations.ts",
    "db:migrate:ax-production": "tsx scripts/apply-ax-child-migrations.ts --production",
    "test:ax-child-guard": "tsx --test tests/ax-child-guard.test.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "drizzle-orm": "^0.45.1",
    "postgres": "^3.4.9",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@gpters/tsconfig": "workspace:*",
    "drizzle-kit": "^0.31.8",
    "typescript": "^5"
  }
}
